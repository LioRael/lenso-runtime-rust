{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lenso-workers-duplex-proof",
  "main": "duplex-worker.mjs",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "enable_request_signal"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 1000
  },
  "observability": {
    "enabled": true
  }
}
